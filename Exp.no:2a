import java.util.Scanner;
public class ArithmeticOperators {
  public static void main(String args[]) {
    Scanner s = new Scanner(System.in);
    while (true) {
      System.out.print("Enter the first number:");
      int x = s.nextInt();
      System.out.print("Enter the second number:");
      int y = s.nextInt();
      System.out.println("Choose the operation you want to perform");
      System.out.println("Choose 1 for ADDITION");
      System.out.println("Choose 2 for SUBTRACTION");
      System.out.println("Choose 3 for MULTIPLICATION");
      System.out.println("Choose 4 for DIVISION");
      System.out.println("Choose 5 for MODULUS");
      System.out.println("Choose 6 for EXIT");
      int n = s.nextInt();
      switch (n) {
        case 1: System.out.println("Result: " + (x + y)); break;
        case 2: System.out.println("Result: " + (x - y)); break;
        case 3: System.out.println("Result: " + (x * y)); break;
        case 4: System.out.println("Result: " + ((float) x / y)); break;
        case 5: System.out.println("Result: " + (x % y)); break;
        case 6: System.exit(0);
      }
    }
  }
}
